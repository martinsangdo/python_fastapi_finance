# Copy this file to .env and fill in your own values.
# Supabase: Project Settings -> Database -> Connection string -> URI
# Replace "postgresql://" with "postgresql+psycopg://" so SQLAlchemy uses psycopg 3.
#
# Local PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/appdb
#
# Supabase example (use the Session pooler host on port 5432):
DATABASE_URL=postgresql+psycopg://postgres.abcdefghijklm:YOUR-PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
